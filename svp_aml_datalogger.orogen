# frozen_string_literal: true

name "svp_aml_datalogger"

using_library "svp_aml_datalogger"
using_task_library "iodrivers_base"

import_types_from "svp_aml_dataloggerTypes.hpp"
import_types_from "std"
import_types_from "base"
import_types_from "iodrivers_base"
import_types_from "svp_aml_datalogger/Configuration.hpp"
import_types_from "svp_aml_datalogger/Measurements.hpp"

task_context "Task", subclasses: "iodrivers_base::Task" do
    needs_configuration

    # Device configuration property
    property "config", "/svp_aml_datalogger/Configuration"

    # Toggles debug messages
    property "verbose", "/bool", false

    # How often to write sensor metadata. Defaults to once per minute.
    property "metadata_update_interval", "/base/Time"

    # High frequency telemetry measurements output port
    output_port "measurements", "/svp_aml_datalogger/Measurements"

    # Sensor metadata output port
    output_port "sensor_metadata", "/svp_aml_datalogger/ParsedDisplaySensors"

    fd_driven
end
